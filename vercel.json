{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/portal-digest",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/potatoes",
      "schedule": "5 15 * * *"
    },
    {
      "path": "/api/cron/portal-notify",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/tiptop-checkin",
      "schedule": "0 16 * * 1"
    },
    {
      "path": "/api/cron/beaker-notify",
      "schedule": "20 * * * *"
    }
  ]
}
